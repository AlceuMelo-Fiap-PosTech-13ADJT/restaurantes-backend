# --- Database Configuration (MySQL) ---
# Password for the MySQL root user
MYSQL_ROOT_PASSWORD=root_password_placeholder

# Password for the application user (app_user)
MYSQL_PASSWORD=app_user_password_placeholder

# --- Spring Boot Application Configuration ---
# Active Spring profile (e.g., prod, dev)
SPRING_PROFILES_ACTIVE=prod

# Password for the application data source
SPRING_DATASOURCE_PASSWORD=app_user_password_placeholder

# --- Server Configuration ---
# Port the application will run on
SERVER_PORT=8080
